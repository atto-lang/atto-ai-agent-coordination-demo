// Fail-closed policy gate for one subject/commit at a time.
// Proof of authentication, trusted CI, reviewer identity and GitHub policy
// MUST be performed by an authorized caller, not inferred from booleans here.
define isolated actor DecisionGateActor as
  // Sole guest-owned persistent state; no ordinary actor instance fields.
  state {
    subject_id: String = "";
    exact_revision: String = "";
    epoch: int = 0;
    checks_passed: bool = false;
    independent_approval: bool = false;
    admission_verified: bool = false;
    closed: bool = true;
  }


  pub begin(String subject, String revision): bool {
    return self.handle_state(critical |s| -> {
      if subject == "" || revision == ""; then return false; fi
      if s.epoch >= 2147483646; then return false; fi
      s.subject_id = subject;
      s.exact_revision = revision;
      s.epoch = s.epoch + 1;
      s.checks_passed = false;
      s.independent_approval = false;
      s.admission_verified = false;
      s.closed = false;
      return true;
    });
  }

  pub record_executed_check(String revision, int epoch,
                                int executed_steps, bool passed,
                                bool trusted_origin): bool {
    return self.handle_state(critical |s| -> {
      if s.closed || epoch != s.epoch ||
         revision != s.exact_revision; then return false; fi
      s.admission_verified = trusted_origin && executed_steps > 0;
      s.checks_passed = s.admission_verified && passed;
      return s.checks_passed;
    });
  }

  pub record_review(String revision, int epoch,
                        bool independently_approved): bool {
    return self.handle_state(critical |s| -> {
      if s.closed || epoch != s.epoch ||
         revision != s.exact_revision; then return false; fi
      s.independent_approval = independently_approved;
      return true;
    });
  }

  pub can_commit(String revision, int epoch): bool {
    return self.handle_state(critical |s| -> {
      return !s.closed && revision == s.exact_revision &&
        epoch == s.epoch && s.admission_verified &&
        s.checks_passed && s.independent_approval;
    });
  }

  pub invalidate(): void {
    return self.handle_state(critical |s| -> {
      s.closed = true;
      s.checks_passed = false;
      s.independent_approval = false;
      s.admission_verified = false;
      return;
    });
  }

  pub current_epoch(): int {
    return self.handle_state(critical |s| -> {
      return s.epoch;
    });
  }
end
