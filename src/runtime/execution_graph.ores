// Single-writer, bounded executable dependency graph.
// Edges point to earlier-declared prerequisite nodes, forming a DAG.
// State transitions represent plans; no tool or LLM is executed here.
define isolated actor ExecutionGraphActor as
  state {
    node_ids: Array<String> = new Array<String>();
    node_states: Array<int> = new Array<int>();
    dependents: Array<String> = new Array<String>();
    prerequisites: Array<String> = new Array<String>();
    revision: int = 0;
    sealed: bool = false;
  }

  // State: 0 pending, 1 running, 2 succeeded, 3 failed, 4 cancelled.
  pub add_node(String id): bool with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if s.sealed || id == "" || s.node_ids.size >= 128 ||
         s.revision >= 2147483646; then return false; fi
      for (const existing of s.node_ids) {
        if existing == id; then return false; fi
      }
      s.node_ids.add(id);
      s.node_states.add(0);
      s.revision = s.revision + 1;
      return true;
    });
  }

  pub depends_on(String node, String prerequisite): bool with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if s.sealed || node == prerequisite ||
         s.dependents.size >= 512 ||
         s.revision >= 2147483646; then return false; fi
      let int node_pos = -1;
      let int prerequisite_pos = -1;
      let int i = 0;
      for (const existing of s.node_ids) {
        if existing == node; then node_pos = i; fi
        if existing == prerequisite; then prerequisite_pos = i; fi
        i = i + 1;
      }
      // Earlier dependencies only; no cycles and no undeclared targets.
      if node_pos < 0 || prerequisite_pos < 0 ||
         prerequisite_pos >= node_pos; then return false; fi
      let int j = 0;
      for (const existing of s.dependents) {
        if existing == node && s.prerequisites[j] == prerequisite; then
          return false;
        fi
        j = j + 1;
      }
      s.dependents.add(node);
      s.prerequisites.add(prerequisite);
      s.revision = s.revision + 1;
      return true;
    });
  }

  pub seal(int expected_revision): bool with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if s.sealed || s.node_ids.size == 0 ||
         expected_revision != s.revision ||
         s.revision >= 2147483646; then return false; fi
      s.sealed = true;
      s.revision = s.revision + 1;
      return true;
    });
  }

  // This read is a candidate list only. A scheduler must re-check start()
  // and authenticate worker identity before dispatching any action.
  pub ready(int expected_revision): Result<Array<String>, String> with state.read {
    return self.handle_state(|s| -> {
      if !s.sealed || expected_revision != s.revision; then
        return Err("stale execution graph");
      fi
      let mut Array<String> result = new Array<String>();
      let int i = 0;
      for (const node of s.node_ids) {
        let bool dependencies_met = true;
        let int dep_i = 0;
        for (const dependent of s.dependents) {
          if dependent == node; then
            let int j = 0;
            let bool found = false;
            for (const known of s.node_ids) {
              if known == s.prerequisites[dep_i] &&
                 s.node_states[j] == 2; then found = true; fi
              j = j + 1;
            }
            if !found; then dependencies_met = false; fi
          fi
          dep_i = dep_i + 1;
        }
        if s.node_states[i] == 0 && dependencies_met; then
          result.add(node);
        fi
        i = i + 1;
      }
      return Ok(result);
    });
  }


  pub start(String node, int expected_revision): bool with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if !s.sealed || expected_revision != s.revision ||
         s.revision >= 2147483646; then return false; fi
      let bool dependencies_met = true;
      let int dep_i = 0;
      for (const dependent of s.dependents) {
        if dependent == node; then
          let int j = 0;
          let bool found = false;
          for (const known of s.node_ids) {
            if known == s.prerequisites[dep_i] &&
               s.node_states[j] == 2; then found = true; fi
            j = j + 1;
          }
          if !found; then dependencies_met = false; fi
        fi
        dep_i = dep_i + 1;
      }
      if !dependencies_met; then return false; fi
      let int i = 0;
      for (const existing of s.node_ids) {
        if existing == node && s.node_states[i] == 0; then
          s.node_states[i] = 1;
          s.revision = s.revision + 1;
          return true;
        fi
        i = i + 1;
      }
      return false;
    });
  }

  pub settle(String node, int expected_revision,
                 bool succeeded): bool with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if !s.sealed || expected_revision != s.revision ||
         s.revision >= 2147483646; then return false; fi

      let int i = 0;
      for (const existing of s.node_ids) {
        if existing == node && s.node_states[i] == 1; then
          if succeeded; then
            s.node_states[i] = 2;
          else
            s.node_states[i] = 3;
          fi
          s.revision = s.revision + 1;
          return true;
        fi
        i = i + 1;
      }
      return false;
    });
  }

  // Cancellation is possible only before a task is dispatched.
  // Running tasks require an external cancellation/compensation protocol.
  pub cancel_pending(String node, int expected_revision): bool with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if !s.sealed || expected_revision != s.revision ||
         s.revision >= 2147483646; then return false; fi
      let int i = 0;
      for (const existing of s.node_ids) {
        if existing == node && s.node_states[i] == 0; then
          s.node_states[i] = 4;
          s.revision = s.revision + 1;
          return true;
        fi
        i = i + 1;
      }
      return false;
    });
  }

  // Step Functions-style failure propagation: a pending node whose
  // prerequisite already failed or was cancelled can never become ready.
  // Mark it cancelled under a single exclusive loan (no tool invocation).
  // This does not cancel running children or roll back external effects.
  pub cancel_blocked(String node, int expected_revision): bool with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if !s.sealed || expected_revision != s.revision ||
         s.revision >= 2147483646; then return false; fi
      let int position = -1;
      let int i = 0;
      for (const known of s.node_ids) {
        if known == node; then position = i; fi
        i = i + 1;
      }
      if position < 0; then return false; fi
      if s.node_states[position] != 0; then return false; fi

      let bool blocked = false;
      let int dep_i = 0;
      for (const dependent of s.dependents) {
        if dependent == node; then
          let int j = 0;
          for (const known of s.node_ids) {
            if known == s.prerequisites[dep_i] &&
               (s.node_states[j] == 3 || s.node_states[j] == 4); then
              blocked = true;
            fi
            j = j + 1;
          }
        fi
        dep_i = dep_i + 1;
      }
      // A pending root node or a node with merely running prerequisites
      // cannot be silently cancelled through this propagation API.
      if !blocked; then return false; fi
      s.node_states[position] = 4;
      s.revision = s.revision + 1;
      return true;
    });
  }

  pub current_revision(): int with state.read {
    return self.handle_state(|s| -> {
      return s.revision;
    });
  }
end
