// Bounded logical registry for agent capabilities and incarnations.
// Do not confuse this with an authenticated transport or a lease service.
// Re-registration is rejected; supervisor issues a new incarnation identity.
define isolated actor AgentRegistryActor as
  // Sole guest-owned persistent state; no ordinary actor instance fields.
  state {
    identities: Array<String> = new Array<String>();
    capabilities: Array<String> = new Array<String>();
    incarnations: Array<int> = new Array<int>();
    revision: int = 0;
  }


  pub register(String id, String capability, int incarnation): bool {
    return self.handle_state(critical |s| -> {
      if id == "" || capability == "" || incarnation <= 0 ||
         s.identities.size >= 1024; then return false; fi
      for (const existing of s.identities) {
        if existing == id; then return false; fi
      }
      s.identities.add(id);
      s.capabilities.add(capability);
      s.incarnations.add(incarnation);
      s.revision = s.revision + 1;
      return true;
    });
  }

  pub supports(String id, int incarnation,
                   String capability): bool {
    return self.handle_state(critical |s| -> {
      let int i = 0;
      for (const existing of s.identities) {
        if existing == id && s.incarnations[i] == incarnation &&
           s.capabilities[i] == capability; then return true; fi
        i = i + 1;
      }
      return false;
    });
  }

  pub current_revision(): int {
    return self.handle_state(critical |s| -> {
      return s.revision;
    });
  }
end
