// An intentionally in-memory state machine for one resumable-workflow model.
// The caller must persist transitions before externally observable side effects.
// Stage values: 0 idle; 1 planned; 2 approved; 3 running; 4 completed;
// 5 cancelled. Terminal stages never restart under the same identity.
define isolated actor AgentWorkflowActor as
  state {
    workflow_id: String = "";
    revision: String = "";
    phase: int = 0;
    transition_number: int = 0;
  }

  pub start(String id, String exact_revision): bool with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if s.phase != 0 || id == "" || exact_revision == ""; then
        return false;
      fi
      s.workflow_id = id;
      s.revision = exact_revision;
      s.phase = 1;
      s.transition_number = s.transition_number + 1;
      return true;
    });
  }

  pub advance(String id, String exact_revision,
                  int expected_transition, int next_phase): bool with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if id != s.workflow_id || exact_revision != s.revision ||
         expected_transition != s.transition_number; then
        return false;
      fi
      if s.phase == 1 && next_phase != 2; then return false; fi
      if s.phase == 2 && next_phase != 3; then return false; fi
      if s.phase == 3 && next_phase != 4; then return false; fi
      if s.phase < 1 || s.phase > 3; then return false; fi
      s.phase = next_phase;
      s.transition_number = s.transition_number + 1;
      return true;
    });
  }

  pub cancel(String id, int expected_transition): bool with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if id != s.workflow_id || expected_transition != s.transition_number ||
         s.phase < 1 || s.phase >= 4; then return false; fi
      s.phase = 5;
      s.transition_number = s.transition_number + 1;
      return true;
    });
  }

  pub stage(): int with state.read {
    return self.handle_state(|s| -> {
      return s.phase;
    });
  }
  pub revision_number(): int with state.read {
    return self.handle_state(|s| -> {
      return s.transition_number;
    });
  }
end
