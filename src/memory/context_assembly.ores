// One actor per task context. Bounded selection of already-verified excerpts.
// Token counts are caller-provided estimates; this is NOT a tokenizer or
// security boundary for prompt injection. All excerpts are untrusted data.
define isolated actor ContextAssemblyActor as
  // All persistent actor-owned fields are in this one state schema.
  state {
    task_id: String = "";
    revision: String = "";
    budget: int = 0;
    remaining: int = 0;
    started: bool = false;
    sealed: bool = false;
    memory_ids: Array<String> = new Array<String>();
    excerpts: Array<String> = new Array<String>();
    evidence_refs: Array<String> = new Array<String>();
  }


  pub begin(String task, String exact_revision,
                int token_budget): bool {
    return self.handle_state(critical |s| -> {
      if s.started || task == "" || exact_revision == "" ||
         token_budget < 1 || token_budget > 16384; then return false; fi
      s.task_id = task;
      s.revision = exact_revision;
      s.budget = token_budget;
      s.remaining = token_budget;
      s.started = true;
      return true;
    });
  }

  pub add(String task, String exact_revision, String memory_id,
              String evidence_ref, String excerpt,
              int estimated_tokens): bool {
    return self.handle_state(critical |s| -> {
      if !s.started || s.sealed || task != s.task_id ||
         exact_revision != s.revision || memory_id == "" ||
         evidence_ref == "" || excerpt == "" ||
         estimated_tokens <= 0 || estimated_tokens > s.remaining ||
         s.memory_ids.size >= 24; then return false; fi
      for (const existing of s.memory_ids) {
        if existing == memory_id; then return false; fi
      }
      s.memory_ids.add(memory_id);
      s.evidence_refs.add(evidence_ref);
      s.excerpts.add(excerpt);
      s.remaining = s.remaining - estimated_tokens;
      return true;
    });
  }

  pub seal(String task, String exact_revision): bool {
    return self.handle_state(critical |s| -> {
      if !s.started || s.sealed || task != s.task_id ||
         exact_revision != s.revision; then return false; fi
      s.sealed = true;
      return true;
    });
  }

  // Return separate arrays, not a trusted system prompt. The caller is
  // responsible for labeling evidence and applying a real tokenizer.
  pub selected_ids(String task, String exact_revision): Result<Array<String>, String> {
    return self.handle_state(critical |s| -> {
      if !s.sealed || task != s.task_id ||
         exact_revision != s.revision; then return Err("context not sealed"); fi
      let mut Array<String> copy = new Array<String>();
      for (const id of s.memory_ids) { copy.add(id); }
      return Ok(copy);
    });
  }

  pub selected_excerpts(String task,
                            String exact_revision): Result<Array<String>, String> {
    return self.handle_state(critical |s| -> {
      if !s.sealed || task != s.task_id ||
         exact_revision != s.revision; then return Err("context not sealed"); fi
      let mut Array<String> copy = new Array<String>();
      for (const excerpt of s.excerpts) { copy.add(excerpt); }
      return Ok(copy);
    });
  }

  pub selected_evidence(String task,
                            String exact_revision): Result<Array<String>, String> {
    return self.handle_state(critical |s| -> {
      if !s.sealed || task != s.task_id ||
         exact_revision != s.revision; then return Err("context not sealed"); fi
      let mut Array<String> copy = new Array<String>();
      for (const evidence of s.evidence_refs) { copy.add(evidence); }
      return Ok(copy);
    });
  }

  pub remaining_budget(): int {
    return self.handle_state(critical |s| -> {
      return s.remaining;
    });
  }
end
