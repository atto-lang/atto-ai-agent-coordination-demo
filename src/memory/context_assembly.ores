// Untrusted CONTEXT REFERENCE MANIFEST. This native actor is NOT a model ingress,
// tokenizer, cryptographic evidence verifier, or an authority boundary.
// It stores no excerpts and cannot publish model-readable context.
// The retired add(raw_excerpt, caller_estimated_tokens) entrypoint is removed;
// downstream callers must fail compilation until migrated.
// A separately authenticated host must independently verify signatures,
// tokenize and bound excerpts, and check revision/capabilities at model dispatch.
// Even a sealed manifest is untrusted, not an approval or verified evidence.
define isolated actor ContextAssemblyActor as
  state {
    task_id: String = "";
    revision: String = "";
    started: bool = false;
    sealed: bool = false;
    memory_ids: Array<String> = new Array<String>();
    evidence_refs: Array<String> = new Array<String>();
  }

  // One manifest per actor instance; no reset or mutable reuse.
  pub begin(String task, String exact_revision): bool with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if s.started || task == "" || exact_revision == ""; then return false; fi
      s.task_id = task;
      s.revision = exact_revision;
      s.started = true;
      return true;
    });
  }

  // This is ONLY an untrusted reference catalog: a caller can forge all
  // these strings. No content, token count, receipt or approval is accepted.
  pub stage_reference(String task, String exact_revision,
                      String memory_id, String evidence_ref): bool
                      with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if !s.started || s.sealed || task != s.task_id ||
         exact_revision != s.revision || memory_id == "" ||
         evidence_ref == "" || s.memory_ids.size >= 24; then
        return false;
      fi
      for (const existing of s.memory_ids) {
        if existing == memory_id; then return false; fi
      }
      s.memory_ids.add(memory_id);
      s.evidence_refs.add(evidence_ref);
      return true;
    });
  }

  pub seal(String task, String exact_revision): bool with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if !s.started || s.sealed || task != s.task_id ||
         exact_revision != s.revision; then return false; fi
      s.sealed = true;
      return true;
    });
  }

  // Manifest observations are not an authentication or authorization grant.
  // Return freshly allocated arrays rather than escaping actor-owned state.
  pub selected_ids(String task, String exact_revision):
                   Result<Array<String>, String> with state.read {
    return self.handle_state(|s| -> {
      if !s.sealed || task != s.task_id ||
         exact_revision != s.revision; then
        return Err("manifest not sealed or scope mismatch");
      fi
      let mut Array<String> copy = new Array<String>();
      for (const id of s.memory_ids) { copy.add(id); }
      return Ok(copy);
    });
  }

  pub selected_evidence(String task, String exact_revision):
                        Result<Array<String>, String> with state.read {
    return self.handle_state(|s| -> {
      if !s.sealed || task != s.task_id ||
         exact_revision != s.revision; then
        return Err("manifest not sealed or scope mismatch");
      fi
      let mut Array<String> copy = new Array<String>();
      for (const reference of s.evidence_refs) { copy.add(reference); }
      return Ok(copy);
    });
  }

  // Backwards-compatible result signature but permanently fail-closed:
  // raw excerpts must never escape through this unauthenticated actor API.
  pub selected_excerpts(String task, String exact_revision):
                        Result<Array<String>, String> with state.read {
    return self.handle_state(|s| -> {
      return Err("native excerpt publication disabled: use authenticated model ingress");
    });
  }

  pub current_count(String task, String exact_revision): Result<int, String>
                    with state.read {
    return self.handle_state(|s| -> {
      if !s.started || task != s.task_id ||
         exact_revision != s.revision; then
        return Err("manifest uninitialized or scope mismatch");
      fi
      return Ok(s.memory_ids.size);
    });
  }
end
