// Bounded materialized read model for previously verified memories.
// Only a capability-authorized indexer may publish or revoke records.
// This actor cannot independently authenticate a caller or receipt string.
define isolated actor MemoryRetrievalActor as
  // All persistent actor-owned fields are in this one state schema.
  state {
    ids: Array<String> = new Array<String>();
    repositories: Array<String> = new Array<String>();
    branches: Array<String> = new Array<String>();
    revisions: Array<String> = new Array<String>();
    subjects: Array<String> = new Array<String>();
    contents: Array<String> = new Array<String>();
    evidence_refs: Array<String> = new Array<String>();
    active: Array<bool> = new Array<bool>();
  }


  pub publish(String id, String repo, String branch, String revision,
                  String subject, String content,
                  String evidence_ref): bool {
    return self.handle_state(critical |s| -> {
      if id == "" || repo == "" || branch == "" || revision == "" ||
         subject == "" || content == "" || evidence_ref == "" ||
         s.ids.size >= 1024; then return false; fi
      for (const existing of s.ids) {
        if existing == id; then return false; fi
      }
      s.ids.add(id);
      s.repositories.add(repo);
      s.branches.add(branch);
      s.revisions.add(revision);
      s.subjects.add(subject);
      s.contents.add(content);
      s.evidence_refs.add(evidence_ref);
      s.active.add(true);
      return true;
    });
  }

  // A superseded or rejected record must be explicitly withdrawn.
  pub withdraw(String id, String evidence_ref): bool {
    return self.handle_state(critical |s| -> {
      let int i = 0;
      for (const existing of s.ids) {
        if existing == id; then
          if s.evidence_refs[i] != evidence_ref || !s.active[i]; then
            return false;
          fi
          s.active[i] = false;
          return true;
        fi
        i = i + 1;
      }
      return false;
    });
  }

  // Exact subject + branch + revision; no fuzzy or embedding claim.
  // Consumers must separately check MemoryInvalidationActor before acting.
  pub recall_ids(String repo, String branch, String revision,
                     String subject, int limit): Result<Array<String>, String> {
    return self.handle_state(critical |s| -> {
      if repo == "" || branch == "" || revision == "" || subject == "" ||
         limit < 1 || limit > 16; then return Err("invalid recall scope"); fi
      let mut Array<String> found = new Array<String>();
      let int i = 0;
      for (const existing of s.ids) {
        if s.active[i] && s.repositories[i] == repo &&
           s.branches[i] == branch && s.revisions[i] == revision &&
           s.subjects[i] == subject && found.size < limit; then
          found.add(existing);
        fi
        i = i + 1;
      }
      return Ok(found);
    });
  }

  pub read(String id, String repo, String branch,
               String revision, String evidence_ref): Result<String, String> {
    return self.handle_state(critical |s| -> {
      let int i = 0;
      for (const existing of s.ids) {
        if existing == id; then
          if !s.active[i] || s.repositories[i] != repo ||
             s.branches[i] != branch || s.revisions[i] != revision ||
             s.evidence_refs[i] != evidence_ref; then
            return Err("stale or unverified memory view");
          fi
          return Ok(s.contents[i]);
        fi
        i = i + 1;
      }
      return Err("memory unavailable");
    });
  }

  pub size(): int {
    return self.handle_state(critical |s| -> {
      return s.ids.size;
    });
  }
end
