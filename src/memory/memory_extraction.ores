// Explicit staging of model- or parser-extracted candidate claims.
// Candidate text remains untrusted, even after local review acknowledgement.
// Extraction itself is performed by an external bounded worker/adapter.
define isolated actor MemoryExtractionActor as
  // All persistent actor-owned fields are in this one state schema.
  state {
    candidate_ids: Array<String> = new Array<String>();
    event_ids: Array<String> = new Array<String>();
    repositories: Array<String> = new Array<String>();
    branches: Array<String> = new Array<String>();
    revisions: Array<String> = new Array<String>();
    subjects: Array<String> = new Array<String>();
    excerpts: Array<String> = new Array<String>();
    kinds: Array<int> = new Array<int>();
    states: Array<int> = new Array<int>();
  }


  // kinds: 1 semantic, 2 episodic, 3 procedural, 4 evidence.
  // States: 0 candidate, 1 forwarded-for-verification, 2 discarded.
  pub stage(String id, String event_id, String repo,
                String branch, String revision, String subject,
                String excerpt, int kind): bool {
    return self.handle_state(critical |s| -> {
      if id == "" || event_id == "" || repo == "" || branch == "" ||
         revision == "" || subject == "" || excerpt == "" ||
         kind < 1 || kind > 4 || s.candidate_ids.size >= 1024; then
        return false;
      fi
      for (const existing of s.candidate_ids) {
        if existing == id; then return false; fi
      }
      s.candidate_ids.add(id);
      s.event_ids.add(event_id);
      s.repositories.add(repo);
      s.branches.add(branch);
      s.revisions.add(revision);
      s.subjects.add(subject);
      s.excerpts.add(excerpt);
      s.kinds.add(kind);
      s.states.add(0);
      return true;
    });
  }

  pub finish(String id, String event_id,
                 bool forward): bool {
    return self.handle_state(critical |s| -> {
      let int i = 0;
      for (const existing of s.candidate_ids) {
        if existing == id; then
          if s.event_ids[i] != event_id || s.states[i] != 0; then
            return false;
          fi
          if forward; then
            s.states[i] = 1;
          else
            s.states[i] = 2;
          fi
          return true;
        fi
        i = i + 1;
      }
      return false;
    });
  }

  // Forwarded != verified. The downstream verification actor owns promotion.
  pub forwarded_excerpt(String id, String event_id,
                            String revision): Result<String, String> {
    return self.handle_state(critical |s| -> {
      let int i = 0;
      for (const existing of s.candidate_ids) {
        if existing == id; then
          if s.states[i] != 1 || s.event_ids[i] != event_id ||
             s.revisions[i] != revision; then
            return Err("candidate has not been forwarded");
          fi
          return Ok(s.excerpts[i]);
        fi
        i = i + 1;
      }
      return Err("unknown candidate");
    });
  }

  pub size(): int {
    return self.handle_state(critical |s| -> {
      return s.candidate_ids.size;
    });
  }
end
