// Bounded capture of immutable event envelopes. Provenance is an untrusted
// claim until an external trusted adapter has verified it. No network I/O.
define isolated actor MemoryIngestionActor as
  state {
    event_ids: Array<String> = new Array<String>();
    repositories: Array<String> = new Array<String>();
    revisions: Array<String> = new Array<String>();
    source_refs: Array<String> = new Array<String>();
    digests: Array<String> = new Array<String>();
    kinds: Array<int> = new Array<int>();
    acknowledged: Array<bool> = new Array<bool>();
  }

  // kind: 1 Git, 2 CI, 3 agent observation, 4 documentation.
  // Tickets are 1-based and never recycled within an incarnation.
  pub ingest(String event_id, String repo, String revision,
                 String source_ref, String digest,
                 int kind): Result<int, String> with state.read, state.write {
    return self.handle_state(critical write |s| -> {
      if event_id == "" || repo == "" || revision == "" ||
         source_ref == "" || digest == "" || kind < 1 || kind > 4; then
        return Err("invalid event envelope");
      fi
      if s.event_ids.size >= 512; then return Err("ingestion full"); fi
      for (const existing of s.event_ids) {
        if existing == event_id; then return Err("duplicate event"); fi
      }
      s.event_ids.add(event_id);
      s.repositories.add(repo);
      s.revisions.add(revision);
      s.source_refs.add(source_ref);
      s.digests.add(digest);
      s.kinds.add(kind);
      s.acknowledged.add(false);
      return Ok(s.event_ids.size);
    });
  }

  // The caller must not acknowledge before the downstream append is durable.
  // This local flag is NOT a transactional outbox or delivery guarantee.
  pub acknowledge(int ticket, String event_id,
                      String digest): bool with state.read, state.write {
    return self.handle_state(critical write |s| -> {
      if ticket <= 0 || ticket > s.event_ids.size; then return false; fi
      val int index = ticket - 1;
      if s.event_ids[index] != event_id ||
         s.digests[index] != digest ||
         s.acknowledged[index]; then return false; fi
      s.acknowledged[index] = true;
      return true;
    });
  }

  pub pending(int ticket, String event_id): bool with state.read, state.write {
    return self.handle_state(critical write |s| -> {
      if ticket <= 0 || ticket > s.event_ids.size; then return false; fi
      val int index = ticket - 1;
      return s.event_ids[index] == event_id && !s.acknowledged[index];
    });
  }

  pub size(): int with state.read {
    return self.handle_state(|s| -> {   return s.event_ids.size;
    });
  }
end
