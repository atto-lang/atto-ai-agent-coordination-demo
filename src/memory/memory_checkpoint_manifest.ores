// In-memory monotonic manifest of externally persisted checkpoints.
// Does not serialize actor state, persist blobs, or implement recovery.
// A trusted storage adapter must durably write/checksum a snapshot BEFORE
// recording this manifest and must verify the blob again during restoration.
define isolated actor MemoryCheckpointManifestActor as
  // All persistent actor-owned fields are in this one state schema.
  state {
    shard_id: String = "";
    revision: String = "";
    storage_ref: String = "";
    checksum: String = "";
    last_event_sequence: int = -1;
    manifest_generation: int = 0;
  }


  pub record(String shard, String exact_revision,
                 String storage_location, String content_checksum,
                 int last_applied_event): bool {
    return self.handle_state(critical |s| -> {
      if shard == "" || exact_revision == "" ||
         storage_location == "" || content_checksum == "" ||
         last_applied_event < 0 || last_applied_event >= 2147483646 ||
         s.manifest_generation >= 2147483646; then return false; fi
      if s.shard_id != "" && shard != s.shard_id; then return false; fi
      if last_applied_event <= s.last_event_sequence; then return false; fi
      s.shard_id = shard;
      s.revision = exact_revision;
      s.storage_ref = storage_location;
      s.checksum = content_checksum;
      s.last_event_sequence = last_applied_event;
      s.manifest_generation = s.manifest_generation + 1;
      return true;
    });
  }

  pub locate(String shard, String exact_revision,
                 int event_sequence,
                 String checksum_expected): Result<String, String> {
    return self.handle_state(critical |s| -> {
      if shard != s.shard_id || exact_revision != s.revision ||
         checksum_expected != s.checksum ||
         event_sequence != s.last_event_sequence ||
         s.manifest_generation <= 0; then
        return Err("checkpoint identity or checksum mismatch");
      fi
      return Ok(s.storage_ref);
    });
  }

  pub event_sequence(): int {
    return self.handle_state(critical |s| -> {
      return s.last_event_sequence;
    });
  }
  pub generation(): int {
    return self.handle_state(critical |s| -> {
      return s.manifest_generation;
    });
  }
end
