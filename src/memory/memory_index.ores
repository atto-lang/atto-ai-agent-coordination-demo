// Bounded exact-match subject index. No embeddings or graph search here.
// Memory IDs must have been verified in the authoritative fact ledger first.
define isolated actor MemoryIndexActor as
  let Array<String> memory_ids = new Array<String>();
  let Array<String> subjects = new Array<String>();
  let Array<String> repositories = new Array<String>();
  let Array<String> branches = new Array<String>();
  let Array<String> revisions = new Array<String>();

  pub link(String memory_id, String subject, String repo,
               String branch, String revision): bool {
    if memory_id == "" || subject == "" || repo == "" || branch == "" ||
       revision == "" || self.memory_ids.size >= 4096; then return false; fi
    let int i = 0;
    for (const existing of self.memory_ids) {
      if existing == memory_id && self.subjects[i] == subject &&
         self.repositories[i] == repo && self.branches[i] == branch &&
         self.revisions[i] == revision; then return false; fi
      i = i + 1;
    }
    self.memory_ids.add(memory_id);
    self.subjects.add(subject);
    self.repositories.add(repo);
    self.branches.add(branch);
    self.revisions.add(revision);
    return true;
  }

  // Returned IDs are candidates. The retrieval actor MUST re-check live
  // verification/supersession and scope before using any result.
  pub find(String subject, String repo, String branch,
               String revision, int limit): Result<Array<String>, String> {
    if subject == "" || repo == "" || branch == "" || revision == "" ||
       limit < 1 || limit > 32; then return Err("invalid lookup"); fi
    let mut Array<String> results = new Array<String>();
    let int i = 0;
    for (const existing of self.subjects) {
      if existing == subject && self.repositories[i] == repo &&
         self.branches[i] == branch && self.revisions[i] == revision &&
         results.size < limit; then
        results.add(self.memory_ids[i]);
      fi
      i = i + 1;
    }
    return Ok(results);
  }

  pub size(): int { return self.memory_ids.size; }
end
